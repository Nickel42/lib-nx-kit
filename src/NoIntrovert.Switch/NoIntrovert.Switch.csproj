<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RootNamespace>NoIntrovert.Switch</RootNamespace>
    <Description>Read, convert, merge and compress Nintendo Switch content packages (NSP, NSZ, XCI, XCZ).</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pure managed zstd (MIT). Used for NCZ compression/decompression. -->
    <PackageReference Include="ZstdSharp.Port" Version="0.8.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NoIntrovert.Switch.Tests" />
  </ItemGroup>

</Project>
