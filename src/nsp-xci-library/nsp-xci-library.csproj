<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>nsp-xci-library</AssemblyName>
    <PackageId>nsp-xci-library</PackageId>
    <RootNamespace>NspXciLibrary</RootNamespace>
    <Description>Read, convert, merge, split and compress Nintendo Switch content packages: NSP, NSZ, XCI and XCZ in any direction, split-file inputs, base + update + DLC merging, and NCA hash verification. Pure managed; bring your own keys.</Description>
    <PackageTags>nintendo-switch;switch;nsp;nsz;xci;xcz;nca;ncz;zstd;rom;convert</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pure managed zstd (MIT). Used for NCZ compression/decompression. -->
    <PackageReference Include="ZstdSharp.Port" Version="0.8.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="nsp-xci-library.Tests" />
  </ItemGroup>

</Project>
